# Environment Configuration

## PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lead_nurturing
DB_USER=postgres
DB_PASSWORD=your_password_here

## n8n Configuration
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost

## CRM Integration
CRM_BASE_URL=http://your-frappe-crm-host:8000
CRM_SID=your_crm_session_id

## Slack (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#leads

## Gmail (Optional)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

## SMTP (Optional)
# Example Gmail SMTP: smtp.gmail.com:587 with STARTTLS (secure=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

## Telegram (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

## Twilio (Optional)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+10000000000

## Metabase
METABASE_PORT=3000

## Lead Scoring Thresholds
HOT_LEAD_THRESHOLD=5
WARM_LEAD_THRESHOLD=2
COLD_LEAD_THRESHOLD=0

## Automation Schedule
CRON_SCHEDULE=*/5 * * * *  # Every 5 minutes
