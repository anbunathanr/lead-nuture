    {
      "parameters": {
        "jsCode": "const doc = $input.first().json.data || {};\nconst email = (doc.email || doc.email_id || '').trim();\nconst phone = (doc.mobile_no || '').trim();\n\n// Normalize phone\nlet p = phone.replace(/[^\\d]/g, '');\nlet phone_normalized = '';\nif (p) {\n  if (phone.startsWith('+')) phone_normalized = '+' + p;\n  else if (p.length === 10) phone_normalized = '+91' + p;\n  else phone_normalized = '+' + p;\n}\n\nconst company = (doc.organization || '').replace(/\\n/g, '').trim();\n\nreturn [{ json: {\n  id: doc.name,\n  name: doc.lead_name || doc.first_name || doc.name,\n  email,\n  phone,\n  phone_normalized,\n  company,\n  product: company || 'our products',\n  has_email: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email),\n  has_phone: phone_normalized.length > 5\n}}];"
      },
