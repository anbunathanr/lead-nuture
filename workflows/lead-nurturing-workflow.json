      "id": "9df245ed-4270-4bec-ad42-8cfa70e79081",
      "name": "Fetch CRM Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -1312,
        -128
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.data || [];\nreturn rows.map(item => {\n  const email = (item.email || item.email_id || '').trim();\n  const phone = (item.mobile_no || '').trim();\n  let p = phone.replace(/[^\\d]/g, '');\n  let phone_normalized = '';\n  if (p) {\n    if (phone.startsWith('+')) phone_normalized = '+' + p;\n    else if (p.length === 10) phone_normalized = '+91' + p;\n    else phone_normalized = '+' + p;\n  }\n  const company = (item.organization || '').replace(/\\n/g, '').trim();\n  return {\n    json: {\n      id: item.name,\n      name: item.lead_name || item.first_name || item.name,\n      email,\n      phone,\n      phone_normalized,\n      company,\n      product: company || 'our products',\n      has_email: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email),\n      has_phone: phone_normalized.length > 5\n    }\n  };\n});"
      },
