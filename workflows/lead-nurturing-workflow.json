    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst setCookie = Array.isArray(headers['set-cookie'])\n  ? headers['set-cookie'].join(', ')\n  : (headers['set-cookie'] || '');\nconst match = setCookie.match(/sid=([^;,]+)/);\nconst sid = match ? match[1] : '';\nif (!sid) throw new Error('Login failed — no sid in Set-Cookie');\nreturn [{ json: { session_id: sid } }];"
      },
      "id": "d1ddeeab-b597-4c1e-a825-c9698dbbeeb9",
      "name": "Extract Session ID",
      "type": "n8n-nodes-base.code",
