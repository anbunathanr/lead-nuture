    {
      "parameters": {
        "method": "GET",
        "url": "http://34.196.221.16:8000/api/resource/CRM Lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ 'sid=' + ($env.CRM_SID || 'YOUR_SESSION_ID') }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "[\"name\",\"email\",\"mobile_no\",\"status\",\"organization\"]"
            }
          ]
        },
        "options": {}
      },
      "id": "node-fetch-crm",
      "name": "Fetch CRM Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.data || [];\n\nreturn rows.map(lead => ({\n  json: {\n    id: lead.name,\n    name: lead.name,\n    email: lead.email,\n    phone: lead.mobile_no,\n    status: lead.status,\n    product: lead.organization,\n    company: lead.organization,\n    login_count: 0\n  }\n}));"
      },
      "id": "node-convert-data",
      "name": "Convert CRM Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "return items.filter(item => item.json.status === 'New');"
      },
      "id": "node-only-new",
      "name": "Only New Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "for (const item of items) {\n  if (item.json.status === 'New') {\n    item.json.lead_type = 'Cold';\n  } else if (item.json.status === 'Contacted') {\n    item.json.lead_type = 'Warm';\n  } else {\n    item.json.lead_type = 'Hot';\n  }\n\n  item.json.lead_status = item.json.lead_type.toUpperCase();\n  item.json.crm_status = item.json.lead_type;\n\n  let p = String(item.json.phone || '').trim();\n  const hasPlus = p.startsWith('+');\n  p = p.replace(/[^\\d]/g, '');\n\n  if (p) {\n    if (hasPlus) item.json.phone_normalized = `+${p}`;\n    else if (p.length === 10) item.json.phone_normalized = `+91${p}`;\n    else item.json.phone_normalized = `+${p}`;\n  } else {\n    item.json.phone_normalized = '';\n  }\n\n  item.json.product = item.json.product || 'our products';\n}\n\nreturn items;"
      },
      "id": "node-classify",
      "name": "Classify + Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [{
            "id": "c1",
            "leftValue": "={{ $json.lead_status }}",
            "rightValue": "HOT",
            "operator": { "type": "string", "operation": "equals" }
          }],
          "combinator": "and"
        }
      },
