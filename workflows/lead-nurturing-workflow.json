        -1536,
        -128
      ]
    },
    {
      "parameters": {
        "url": "http://{{CRM_HOST}}/api/resource/CRM Lead",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "[\"name\",\"lead_name\",\"first_name\",\"email\",\"mobile_no\",\"status\",\"organization\",\"source\"]"
            },
            {
              "name": "filters",
              "value": "[[\"status\",\"=\",\"New\"]]"
            },
            {
              "name": "limit",
              "value": "2"
            }
